//
//  Probe.xcconfig
//  AppGroupProbe
//
//  Единая конфигурация идентичности для основного приложения и Widget Extension.
//  Все три значения обязаны совпадать с provisioning profile, которым подписывает GBox:
//
//  PROBE_MAIN_BUNDLE_ID  — explicit App ID из профиля (application-identifier: <TeamID>.app.yam53.taro5888)
//  PROBE_WIDGET_BUNDLE_ID — суффиксный Bundle ID расширения (GBox применяет main-profile к расширениям)
//  PROBE_APP_GROUP_ID    — ОДНА явно выбранная группа из пяти разрешённых профилем
//
//  ⚠️ При смене PROBE_APP_GROUP_ID синхронно обнови entitlements в project.yml
//     (секция entitlements у обоих таргетов) — audit-скрипт проверяет совпадение.
//

PROBE_MAIN_BUNDLE_ID = app.yam53.taro5888
PROBE_WIDGET_BUNDLE_ID = app.yam53.taro5888.widget
PROBE_APP_GROUP_ID = group.c2fefdd0db2e255e.1
